# ---------------------------------------------------------------
# SellerTribe - seller website frontend environment variables
# Copy this file and name the copy ".env" (in this same folder).
# Only variables starting with VITE_ are visible to the React code.
# NEVER put secrets here - anyone can see the frontend code.
# ---------------------------------------------------------------

# Address of the SellerTribe backend API (no trailing slash)
VITE_API_URL=http://localhost:5001/api

# Address of the buyer marketplace website (used for "View on marketplace" links)
VITE_MARKETPLACE_URL=http://localhost:5173
