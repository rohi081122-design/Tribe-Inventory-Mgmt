# ---------------------------------------------------------------
# SellerTribe - seller website backend environment variables
# 1. Copy this file and name the copy ".env" (in this same folder)
# 2. Replace every PASTE_... value with your own value
# 3. Never commit the real .env file to Git
# ---------------------------------------------------------------

# Use the SAME MongoDB connection string as TribalMarketplace/backend/.env
# so that products uploaded here appear on the marketplace.
MONGO_URI=PASTE_YOUR_MONGODB_CONNECTION_URL_HERE

# Port for this backend (the marketplace backend uses 5000)
PORT=5001

# Secret used to sign seller login tokens. Use a DIFFERENT long random string than the marketplace.
# Generate one in PowerShell with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=PASTE_YOUR_OWN_LONG_RANDOM_SECRET_HERE

# Secret used to protect stored Aadhaar numbers (they are saved only as a keyed hash).
# Generate it the same way. Do NOT change it later, or existing sellers cannot log in with Aadhaar.
AADHAAR_SECRET=PASTE_ANOTHER_LONG_RANDOM_SECRET_HERE

# Address of the SellerTribe React frontend (used for CORS)
CLIENT_URL=http://localhost:5174

# development or production
NODE_ENV=development

# Cloudinary credentials (Cloudinary Dashboard -> Settings -> API Keys)
CLOUDINARY_CLOUD_NAME=PASTE_YOUR_CLOUDINARY_CLOUD_NAME_HERE
CLOUDINARY_API_KEY=PASTE_YOUR_CLOUDINARY_API_KEY_HERE
CLOUDINARY_API_SECRET=PASTE_YOUR_CLOUDINARY_API_SECRET_HERE

# Password for the team page (http://localhost:5174/admin) where the Tribal Marketplace team
# approves sellers. Only approved sellers can upload products. Use at least 10 characters.
ADMIN_PASSWORD=PASTE_YOUR_TEAM_PASSWORD_HERE
