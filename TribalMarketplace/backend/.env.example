# ---------------------------------------------------------------
# Tribal Marketplace - backend environment variables
# 1. Copy this file and name the copy ".env" (in this same folder)
# 2. Replace every PASTE_... value with your own value
# 3. Never commit the real .env file to Git
# ---------------------------------------------------------------

# MongoDB connection string (MongoDB Atlas or a local MongoDB server)
# Atlas example:  mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/tribal_marketplace?retryWrites=true&w=majority
# Local example:  mongodb://127.0.0.1:27017/tribal_marketplace
MONGO_URI=PASTE_YOUR_MONGODB_CONNECTION_URL_HERE

# Port for the backend server
PORT=5000

# Secret used to sign login tokens (JWT). Use a long random string (at least 32 characters).
# Generate one in PowerShell with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=PASTE_YOUR_OWN_LONG_RANDOM_SECRET_HERE

# Address of the React frontend (used for CORS). Separate several addresses with commas.
CLIENT_URL=http://localhost:5173

# development or production
NODE_ENV=development

# Note: Cloudinary keys are NOT needed here. Product images are uploaded by the
# SellerTribe website, so the Cloudinary keys go in SellerTribe/backend/.env

# Platform charge added on top of each product price at checkout (how the marketplace earns).
# PLATFORM_FEE_PERCENT = percent of the product price, PLATFORM_FEE_MIN = minimum rupees per product.
PLATFORM_FEE_PERCENT=5
PLATFORM_FEE_MIN=10

# Delivery charge when the buyer lives far from the seller (see config/deliveryCharge.js).
# Free inside DELIVERY_FREE_ZONE_KM around the seller; farther away DELIVERY_CHARGE_PER_KM rupees
# for every km beyond the zone, at least DELIVERY_MIN_CHARGE and at most DELIVERY_MAX_CHARGE rupees.
DELIVERY_FREE_ZONE_KM=50
DELIVERY_CHARGE_PER_KM=1
DELIVERY_MIN_CHARGE=30
DELIVERY_MAX_CHARGE=500
